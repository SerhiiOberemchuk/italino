# Obriym CRM — базовий URL інстансу (без /api/v1 і без слеша в кінці)
OBRIYM_API_URL=https://crm.example.com

# Scoped Bearer token сайту (products:read, orders:read, orders:write, shipments:read, ...)
# Видається в CRM: Settings → Integrations → API token. Ніколи не комітити реальний токен.
OBRIYM_API_TOKEN=obr_xxx

# Канонічна адреса сайту (metadata, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
