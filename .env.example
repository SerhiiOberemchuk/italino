# Obriym CRM — базовий URL інстансу (без /api/v1 і без слеша в кінці)
OBRIYM_API_URL=https://obriym-crm.com

OBRIYM_API_TOKEN=

# Адреса вітрини. На проді ОБОВ'ЯЗКОВО https: CRM приймає returnUrl лише по
# https, і без нього після оплати покупець повертається на типову сторінку CRM
# (/payment/complete), а не на /order/[orderId] у магазині.
#
# SITE_URL читається на рантаймі — саме його задавайте в оточенні продакшену.
SITE_URL=https://italino.shop/

# Запасний варіант; Next вшиває його значення у збірку, тож зміна без
# пересборки не діє. Лишено для локальної розробки.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only products assigned to the ITALINO warehouse
OBRIYM_WAREHOUSE_ID=

# Спільний секрет для POST /api/revalidate (вебхук CRM скидає кеш каталогу)
REVALIDATE_SECRET=
